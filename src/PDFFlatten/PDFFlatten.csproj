<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>PDFFlatten</AssemblyName>
    <RootNamespace>PDFFlatten</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latestMajor</LangVersion>
    <Description>Small, dependency-free AcroForm flattening for classic PDF files.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>PDFFlatten</PackageId>
    <PackageProjectUrl>https://github.com/jonnymuir/PDFFlatten</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jonnymuir/PDFFlatten</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>pdf;acroform;flatten;forms</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Production-hardening release: parser now safely rejects 10 unsupported PDF structures (xref-stream, object-stream, encryption, XFA, rotation, inherited resources, etc.) with fail-closed exceptions. Test suite expanded from 15 to 37 tests with renderability assertions. Production-ready for classic AcroForm PDFs with direct page annotations; comprehensive documentation on supported slice, limitations, and deployment guidance.</PackageReleaseNotes>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>
</Project>
