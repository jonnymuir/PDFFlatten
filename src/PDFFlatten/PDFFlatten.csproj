<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>PDFFlatten</AssemblyName>
    <RootNamespace>PDFFlatten</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latestMajor</LangVersion>
    <Description>Small, dependency-free AcroForm flattening for classic PDF files.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>PDFFlatten</PackageId>
    <PackageProjectUrl>https://github.com/jonnymuir/PDFFlatten</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jonnymuir/PDFFlatten</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>pdf;acroform;flatten;forms</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Security hardening patch: added explicit in-memory caps for whole-input buffering, direct stream /Length reads, and FlateDecode appearance inspection; normalized malformed numeric and stream-length failures to the documented InvalidOperationException contract; documented and regression-tested the VB.NET fallback pattern for rejected PDFs. All 61 tests passing.</PackageReleaseNotes>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>
</Project>
